METHOD Every( oReq, nErr ) CLASS ApiClient

   LOCAL cReply, hMsg

   ::cError := ""
   nErr := KVP_OK
   cReply := ::transport:Call( oReq:Encode(), @nErr )
   IF cReply == NIL
      IF nErr == KVP_OK
         nErr := KVP_E_CALL
      ENDIF
      RETURN .F.
   ENDIF
   hMsg := KvpParse( cReply, @nErr )
   IF hMsg == NIL
      RETURN .F.
   ENDIF
   IF KvpErrorText( hMsg ) != NIL
      ::cError := KvpErrorText( hMsg )
      nErr := KVP_E_REPLY
      RETURN .F.
   ENDIF

   RETURN .T.
