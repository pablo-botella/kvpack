# The test service: a declaration spread over several files, with every type,
# lists, optional and nullable fields, records and tuplesets. Its four calls:
#   login   declared here; its reply holds records of api_records.kvp
#   ping    declared here; no fields and no reply
#   query   in api_query.kvp
#   every   in api_every.kvp
service api

# What each language calls the request of ping: a name of its own, so that
# the code the tests compile carries a type that was renamed.
names go
    command ping = heartbeat
names c
    command ping = api_heartbeat
names harbour
    command ping = api_heartbeat

command login = 1
    user      text   = 1
    password  text   = 2
    when      ts     = 3   optional
    tags      text   = 4   list

reply login
    name      text   = 1
    expires   ts     = 2
    level     int32  = 3   optional
    events    event  = 4   list
    owner     person = 5   optional

command ping = 2

include "api_records.kvp"
include "api_query.kvp"
include "api_every.kvp"
